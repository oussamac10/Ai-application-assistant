{
    "permissions": {
        "allow": [
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(rg:*)",
            "Bash(find:*)",
            "Bash(pytest:*)",
            "Bash(ruff:*)",
            "Bash(mypy:*)",
            "Bash(npm test:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run typecheck:*)"
        ],
        "deny": [
            "Bash(git push --force:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean -fd:*)",
            "Bash(rm -rf:*)"
        ]
    }
}