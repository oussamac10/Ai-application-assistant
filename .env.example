# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_pass
POSTGRES_DB=ai_form_assistant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connection URL (for local dev without Docker, replace postgres with localhost)
DATABASE_URL=postgresql://postgres:postgres_local_dev_pass@postgres:5432/ai_form_assistant

# Form Sessions Configuration
FORM_SESSION_TTL_HOURS=24
SESSION_TOKEN_SECRET=replace-with-secure-local-secret

# Document Upload & Analysis Configuration
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_UPLOAD_MAX_PAGES=20
DOCUMENT_EXPIRATION_HOURS=24
DOCUMENT_STORAGE_PATH=/tmp/ai-form-assistant/documents
DOCUMENT_ANALYSIS_VERSION=1
DOCUMENT_TEXT_SAMPLE_LIMIT=5000

# AI Provider
# Supported values: mock, ollama, gemini
# Use "mock" for automated tests and local development without a running model.
# Use "gemini" to route requests to Google Gemini API (recommended for cloud LLM).
# Use "ollama" to route requests to a local Ollama instance.
AI_PROVIDER=gemini

# Allow MockAIProvider as fallback when LLM is unavailable (not recommended in production)
AI_ALLOW_MOCK_FALLBACK=false

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# Ollama Configuration (optional local alternative)
# When running inside Docker, use host.docker.internal to reach a host-machine Ollama instance.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
# 120s to leave headroom for a cold model load on local/dev hardware; a
# warm request typically completes in a few seconds.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1
OLLAMA_CACHE_ENABLED=false

# OCR Configuration
# Supported values: mock, local
# Use "mock" for automated tests and local development without tesseract installed.
# Use "local" to run PyMuPDF page rendering + pytesseract OCR.
OCR_PROVIDER=local
OCR_EXPIRATION_HOURS=24
OCR_RENDER_STORAGE_PATH=/tmp/ai-form-assistant/ocr-render
OCR_RENDER_DPI=300
OCR_TIMEOUT_SECONDS=120

# Dynamic Field Detection Configuration
# Supported values: mock, local, azure, hybrid
#
# "hybrid" (Phase 16) runs the local pass first and calls Azure only when the
# local result scores below HYBRID_LOCAL_QUALITY_THRESHOLD, so an ordinary
# digital form costs nothing. It works with Azure unconfigured — it simply
# cannot escalate, and always serves the local result.
FIELD_DETECTION_PROVIDER=local
FIELD_DETECTION_ANALYSIS_VERSION=1

# Hybrid local-first routing (Phase 16). Deterministic: no model participates
# in the decision to call a paid service.
#   HYBRID_LOCAL_QUALITY_THRESHOLD  escalate below this weighted 0-1 score
#   HYBRID_MAX_ESCALATION_PAGES     hard ceiling; longer documents never escalate
HYBRID_LOCAL_QUALITY_THRESHOLD=0.55
HYBRID_MAX_ESCALATION_PAGES=10

# Azure Document Intelligence (Phase 14) — optional second field-detection
# provider. Only required when FIELD_DETECTION_PROVIDER=azure; leave unset
# for the local/mock providers.
#
# SECURITY: the API key is backend-only. It is never sent to the frontend,
# never logged, and never included in an API response or error message.
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=120
AZURE_DOCUMENT_INTELLIGENCE_MAX_RETRIES=1

# Automatic Upload-to-Questions Flow (Phase 13)
# Deterministic confidence routing thresholds — never AI-decided. A field
# with confidence >= FIELD_AUTO_CONFIRM_THRESHOLD is auto-confirmed; between
# FIELD_CLARIFICATION_THRESHOLD (inclusive) and FIELD_AUTO_CONFIRM_THRESHOLD
# is "medium" confidence (still used automatically, flagged for later admin
# review); below FIELD_CLARIFICATION_THRESHOLD is never used automatically.
FIELD_AUTO_CONFIRM_THRESHOLD=0.75
FIELD_CLARIFICATION_THRESHOLD=0.4
# "auto": normal-user upload flow generates questions automatically with no
# manual field-review step. "manual": preserves the exact Phase 11 behavior
# (every field starts pending_review; admin/debug review UI only).
FIELD_DETECTION_REVIEW_MODE=auto

# Question Catalog Configuration
QUESTION_ALLOW_PENDING_REUSE=false
QUESTION_AI_TRANSLATION_ENABLED=true

# Batched translation of dynamically detected field labels and choice options.
# One request carries up to AI_TRANSLATION_BATCH_SIZE texts instead of one
# request per text (a 24-field document went from 28 AI calls to 4), and up to
# AI_TRANSLATION_CONCURRENCY of those requests run at once. Keep the
# concurrency small: a single local Ollama instance queues work beyond its own
# parallelism, so a large value trades latency for timeouts.
AI_TRANSLATION_BATCH_SIZE=12
AI_TRANSLATION_CONCURRENCY=3

# --- Translation provider (Phase 15) ---------------------------------------
# Which provider translates display text (field labels, choice option labels).
# Separate from AI_PROVIDER: translation is a different capability from
# language understanding, and a dedicated service does it faster and more
# predictably than a local LLM. One of: mock | ollama | azure.
TRANSLATION_PROVIDER=ollama
# Used only when the primary fails, and must differ from it. "none" disables
# provider fallback; source text remains the final fallback either way, so a
# document is never blocked. Intended production pairing: azure + ollama.
TRANSLATION_FALLBACK_PROVIDER=none

# Azure Translator. Backend-only — never exposed to the frontend. Validated
# only when azure is the selected or fallback provider, so a developer with no
# Azure account can still boot. Real values belong in the git-ignored root
# .env, never here.
AZURE_TRANSLATOR_ENABLED=false
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_API_KEY=
# Required for a regional (non-global) resource; Azure rejects the request
# without it.
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_API_VERSION=3.0
AZURE_TRANSLATOR_TIMEOUT_SECONDS=30
AZURE_TRANSLATOR_MAX_RETRIES=1
# Azure's documented per-request limits are 1000 elements / 50,000 characters;
# 50 stays well inside both while still collapsing a document into one call.
AZURE_TRANSLATOR_MAX_BATCH_SIZE=50

# Application log level. Set to DEBUG for more detail; provider and pipeline
# diagnostics (durations, counts) are emitted at INFO.
LOG_LEVEL=INFO
QUESTION_AI_GENERATION_ENABLED=true
QUESTION_ADMIN_API_ENABLED=false

# User Accounts (Phase 12)
# AUTH_COOKIE_SECURE must be true in production (HTTPS-only cookie).
# Keep it false only for local HTTP development.
AUTH_SECRET=replace-with-a-long-random-local-development-secret
AUTH_SESSION_TTL_HOURS=336
AUTH_COOKIE_NAME=auth_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
PASSWORD_MIN_LENGTH=10
# Optional comma-separated list of emails promoted to platform_admin on register/login
ADMIN_EMAILS=

# Frontend-only (Phase 13): reveals the technical field-review debug link
# on the upload flow. Never enable in production.
NEXT_PUBLIC_ENABLE_DETECTION_DEBUG_UI=false

# Comma-separated list of frontend origins allowed to send credentialed
# (cookie-bearing) requests. Required to be explicit (no wildcard) once
# auth relies on cookies — browsers reject a wildcard origin combined with
# credentials per the CORS spec.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003
